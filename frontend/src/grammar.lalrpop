use crate::parser::{Stmt, FnDef, FnCall, PrintStmt, AssignStmt, Expr, CompareOp, BinaryExpr, Op};

grammar;

/// A comma seperated list of items.
Comma<T>: Vec<T> = { // (1)
    <mut v:(<T> ",")*> <e:T?> => match e { // (2)
        None => v,
        Some(e) => {
            v.push(e);
            v
        }
    }
};

/// A program consisting of many statements.
pub Program: Vec<Stmt> = {
    <s:(Stmt)+> => s
}

/// A statement.
pub Stmt: Stmt = {
    /// A function definition.
    "fn" <name:PlainIdent> "(" <params:Comma<PlainIdent>> ")" <code:CodeBlock> => {
        Stmt::FnDef(FnDef {
            name: name,
            params: params,
            code: match code {
                Stmt::Block(b) => b,
                s => panic!("expected code block after fn, got '{:?}'", s)
            }
        })
    },

    /// A return statement.
    "ret" <Expr> StmtDelim => Stmt::Return(<>),

    /// An if statement.
    "if" <cond:Comparison> <c:CodeBlock> => Stmt::If {
        comparison: cond,
        code: match c {
            Stmt::Block(v) => v,
            _ => panic!("Code Block must follow if statement!")
        }
    },

    /// A code block.
    <CodeBlock> => <>,

    /// A statement that executes terminal code directly.
    "'" <PlainStr> "'" StmtDelim => Stmt::Bash(<>),

    /// A postfix operator statement that indicates an expression should be printed to console.
    <Expr> "?" => Stmt::Print(PrintStmt {
        value: <>
    }),

    // A print statement
    "print" <Expr> StmtDelim => Stmt::Print(PrintStmt {
        value: <>
    }),

    // An assignment statement
    <i:Ident> "=" <v:Expr> StmtDelim => Stmt::Assign(AssignStmt {
        name: match *i {
            Expr::Ident(i) => i.to_string(),
            _ => unimplemented!()
        },
        value: v
    }),

    // An expression
    <Expr> StmtDelim => Stmt::Expr(<>)
}

/// A code block.
CodeBlock: Stmt = "{" <p:Program> "}" => Stmt::Block(p);

/// Stmt Delimiter.
StmtDelim = ";";

/// An expression.
pub Expr: Box<Expr> = {
    /// An expression that gathers input from terminal, with an optional message prepended.
    "read" => Box::new(
        Expr::Read
    ),

    /// A function call.
    <i:Ident> "!(" <args:Comma<Expr>> ")" => Box::new(
        Expr::FnCall(FnCall {
            name: match *i {
                Expr::Ident(i) => i,
                _ => panic!("Ident expected before args in function call!")
            },
            args: args
        })
    ),

    // Bool stuff
    "true" => Box::new(Expr::Bool(true)),
    "false" => Box::new(Expr::Bool(false)),

    // Number expressions
    <l:Expr> "+" <r:Factor> => Box::new(
        Expr::Binary(BinaryExpr { lhs: l, op: Op::Plus, rhs: r })
    ),
    <l:Expr> "-" <r:Factor> => Box::new(
        Expr::Binary(BinaryExpr { lhs: l, op: Op::Minus, rhs: r })
    ),
    Factor,

    // Common types
    Str,
    Ident
};

/// Equality condition.
pub Comparison: Box<Expr> = <l:Expr> <cop:CompareOp> <r:Expr> => Box::new(
    Expr::Comparison {
        lhs: l,
        op: cop,
        rhs: r
    }
);

/// An equality operator
CompareOp: CompareOp = {
    ">" => CompareOp::Greater,
    "<" => CompareOp::Less,
    "!=" => CompareOp::NEqual,
    "==" => CompareOp::Equal,
    ">=" => CompareOp::GreaterEqual,
    "<=" => CompareOp::LessEqual,
};

/// A factor.
Factor: Box<Expr> = {
    <l:Factor> "*" <r:Term> => Box::new(
        Expr::Binary(BinaryExpr { lhs: l, op: Op::Mult, rhs: r })
    ),
    <l:Factor> "/" <r:Term> => Box::new(
        Expr::Binary(BinaryExpr { lhs: l, op: Op::Div, rhs: r })
    ),
    Term
};

/// A term.
Term: Box<Expr> = {
    Num,
    "(" <Expr> ")"
};

/// An ident.
pub Ident: Box<Expr> = r#"[a-z_A-Z]+"# => Box::new(
    Expr::Ident(
        <>
        .to_string()
        .replace("\"", "")
    )
);

/// An ident that is returned as a string.
pub PlainIdent: String = r#"[a-z_A-Z]+"# => <>.to_string().replace("\"", "");

/// A numeric literal.
Num: Box<Expr> = {
    r"[0-9.]+" => Box::new(Expr::Num(<>.parse().expect("Couldn't parse number from str!")))
};

/// A string.
pub Str: Box<Expr> = r#""([^"\\\x00-\x1F]|\\(["\\bnfrt/]|u[a-fA-F0-9]{4}))*""# => Box::new(
    Expr::Str(
        <>
        .to_string()
        .replace("\"", "")
    )
);

/// A plain non-expr string that returns `String`.
pub PlainStr: String = r#""([^"\\\x00-\x1F]|\\(["\\bnfrt/]|u[a-fA-F0-9]{4}))*""# => 
    String::from(<>).replace("\"", "");
